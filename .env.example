# Copy this file to .env and fill in your own values. Never commit .env.

# Database, used by the prod profile. docker compose sets DB_URL itself and has
# a local-only default password, so these are optional there.
DB_URL=jdbc:postgresql://localhost:5432/ticketwise
DB_USERNAME=ticketwise
DB_PASSWORD=

# Gemini. If GEMINI_API_KEY is empty, the app uses the rule-based classifier only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=5000
# Only needed to point the app at a test server instead of Google.
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# Signs login tokens. Use at least 32 random characters. If empty, the app makes
# a random key at startup, so tokens stop working after a restart.
JWT_SECRET=
JWT_EXPIRATION_MINUTES=60

# Creates the first admin at startup, if this account doesn't exist yet.
# Without an admin, nobody can be made an agent.
ADMIN_EMAIL=
ADMIN_PASSWORD=
